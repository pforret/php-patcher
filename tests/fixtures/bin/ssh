#!/usr/bin/env bash
# fake ssh for the bats tests: "ssh -G" goes to the real ssh (it does not connect),
# anything else prints canned output, fails for hosts named bad*,
# wants a sudo password (exit 3) for hosts named sudo*,
# or stays below --fixed after the upgrade (exit 5) for hosts named waiting*
real_ssh="${REAL_SSH:-/usr/bin/ssh}"
for arg in "$@"; do
  [[ $arg == "-G" ]] && exec "$real_ssh" "$@"
done
host=""
while (($#)); do
  case "$1" in
  -o | -F) shift 2 ;;
  -*) shift ;;
  *) host="$1"; shift; break ;;
  esac
done
stdin=$(cat) # «IFS= read -r sudo_pass», the sudo password, then the remote script
sudo_pass=$(sed -n 2p <<<"$stdin")
printf "%s\n" "** WARNING: connection is not using a post-quantum key exchange algorithm." "** This session may be vulnerable to \"store now, decrypt later\" attacks." >&2
if [[ $host == bad* ]]; then
  echo "ssh: connect to host $host port 22: Connection refused" >&2
  exit 255
fi
if [[ $host == sudo* && $sudo_pass != secret ]]; then
  # host that needs the sudo password «secret»
  echo "  FakeOS 1.0"
  echo "  ERROR: needs a sudo password"
  echo "SUDO_CMD sudo apt-get update && sudo apt-get install -y --only-upgrade php8.4-fpm"
  exit 3
fi
if [[ $host == current* ]]; then
  # host that is already on the newest packages, but not on --fixed (exit 4)
  echo "  FakeOS 1.0"
  echo "  php (cli)      8.4.26   PATCH (fixed in 8.4.27)"
  echo "  ERROR: no newer PHP packages in the package sources yet (the new release is not built yet)"
  echo "W: Failed to fetch https://ppa.launchpadcontent.net/x/y/ubuntu/dists/noble/InRelease  503  Service Unavailable" >&2
  exit 4
fi
if [[ $host == focal* ]]; then
  # Ubuntu 20.04: nothing newer, ever (exit 4)
  echo "  Ubuntu 20.04.6 LTS"
  echo "  WARNING: Ubuntu 20.04 gets no newer PHP 8.x packages (no PPA anymore): move to Ubuntu 24.04"
  echo "  ERROR: no newer PHP packages: Ubuntu 20.04 has no PHP repository anymore"
  exit 4
fi
if [[ $host == waiting* ]]; then
  # host that got upgraded, but not up to --fixed (exit 5)
  echo "  FakeOS 1.0"
  echo "  php (cli)      8.4.26   PATCH (fixed in 8.4.27)"
  echo "  ERROR: upgraded, but still below the fixed version"
  exit 5
fi
echo "  FakeOS 1.0"
echo "PROGRESS apt-get update"
echo "  php (cli)      8.4.27   OK"
echo "  args: $*"
